configuration {
    modi: "drun,run,filebrowser,window";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: " 󰕰  Window ";
    sidebar-mode: true;
}

@theme "/dev/null"

* {
    bg-col:  #1e1e2ee6;
    bg-col-light: #313244;
    border-col: #89b4fa;
    selected-col: #313244;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;
    grey: #6c7086;
    width: 600;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 400px;
    border: 2px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 12px;
}

mainbox {
    background-color: transparent;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 6px;
    padding: 2px;
}

prompt {
    background-color: @blue;
    padding: 6px 12px;
    text-color: #11111b;
    border-radius: 6px;
    margin: 10px 0px 0px 10px;
}

entry {
    padding: 6px;
    margin: 10px 10px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    border-radius: 6px;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 10px 10px 10px;
    margin: 10px 0px 0px 0px;
    columns: 2;
    lines: 8;
    background-color: transparent;
}

element {
    padding: 6px;
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 6px;
}

element-icon {
    size: 24px;
    margin: 0px 8px 0px 0px;
}

element selected {
    background-color:  @selected-col;
    text-color: @blue;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: @blue;
    text-color: #11111b;
}
